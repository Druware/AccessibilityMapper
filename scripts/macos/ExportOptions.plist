<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID (direct distribution outside the Mac App Store). -->
	<key>method</key>
	<string>developer-id</string>

	<!-- Export a .app on disk rather than uploading to App Store Connect. -->
	<key>destination</key>
	<string>export</string>

	<key>teamID</key>
	<string>Z44257Z59V</string>

	<!--
	    Automatic signing is required here: the app is sandboxed, so a
	    Developer ID provisioning profile must exist. Manual signing fails
	    with "requires a provisioning profile" unless profiles are checked in.
	    Combined with -allowProvisioningUpdates, Xcode fetches/creates them.
	-->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Do not strip bitcode/symbols surprises; keep symbols for crash reports. -->
	<key>uploadSymbols</key>
	<false/>
</dict>
</plist>
