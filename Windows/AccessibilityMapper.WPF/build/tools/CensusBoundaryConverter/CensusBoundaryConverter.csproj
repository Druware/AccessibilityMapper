<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool, not shipped. Converts the U.S. Census cartographic boundary
       shapefiles into the artifact the app bundles. Deliberately outside the solution:
       it runs about once a year, when a new Census vintage lands. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CensusBoundaryConverter</AssemblyName>
    <RootNamespace>AccessibilityMapper.Build</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
