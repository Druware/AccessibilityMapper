<Window x:Class="AccessibilityMapper.App.Views.BoundaryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Which one?"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Shown only when a boundary search matches more than one place (issues.md §4).
         A single match never reaches here. -->
    <StackPanel Margin="20,18,20,18">

        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

        <ListBox x:Name="CandidateList" MaxHeight="280"
                 MouseDoubleClick="CandidateList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" />
                        <TextBlock Text="{Binding Qualifier}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="88" Height="30" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Add" Width="88" Height="30" IsDefault="True" Click="Accept_Click" />
        </StackPanel>

    </StackPanel>
</Window>
